{
  "extends": [
    "prettier"
  ],
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "warn",
    "eqeqeq": "warn",
    "curly": "warn",
    "semi": "warn",
    "quotes": "warn"
  }
}
